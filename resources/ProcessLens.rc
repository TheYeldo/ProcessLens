#include <winuser.h>
1 RT_MANIFEST "ProcessLens.manifest"
101 ICON "../assets/ProcessLens.ico"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ProcessLens native system monitor"
            VALUE "FileVersion", "2.0.0"
            VALUE "ProductName", "ProcessLens"
            VALUE "ProductVersion", "2.0.0"
            VALUE "OriginalFilename", "ProcessLens.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
